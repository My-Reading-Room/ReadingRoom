{
  "name": "my-reading-room",
  "version": "3.0.0-alpha.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:legacy": "npm --prefix legacy test",
    "db:types": "supabase gen types --lang typescript --schema public > src/types/database.ts && prettier --write src/types/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "typescript": "^5"
  },
  "description": "Personal reading tracker with shared, view-only partner profiles.",
  "engines": {
    "node": ">=22"
  }
}

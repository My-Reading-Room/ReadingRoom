# Copy to .env.local and fill in. Never commit .env.local.
# Find these in Supabase dashboard → Project Settings → API Keys.

# Public values (exposed to the browser; safe only because RLS protects every table)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Canonical origin of this deployment, used to build auth email redirect links.
# Never derive this from the request Host header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never prefix these with NEXT_PUBLIC_; read in src/utils/server-env.ts) ---

# Optional. Google Books fallback for catalog lookups; raises Google's quota.
GOOGLE_BOOKS_API_KEY=
# Optional. Enables series reading-order lookups via List Of Books.
LOB_API_KEY=
# Optional. Contact email sent to Open Library in the User-Agent, which raises
# our shared rate limit from 1 to 3 requests/second.
OPEN_LIBRARY_CONTACT=

# Optional. "true" sends the CSP as Report-Only (for trialling policy changes).
CSP_REPORT_ONLY=

# NEVER add the Supabase secret / service_role key with a NEXT_PUBLIC_ prefix.
